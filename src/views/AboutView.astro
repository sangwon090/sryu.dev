    </div>
  </article>
</BaseLayout>

<style>
  .about-page {
    max-width: var(--width-prose);
  }

  .page-head { margin-bottom: var(--space-3); }

  .page-head h1 { margin: 0; font-size: var(--fs-2xl); }
</style>
