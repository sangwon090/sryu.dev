---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getUTCFullYear();

// Internal links resolve against the current locale; external links are
// absolute and locale-independent.
const links = [
  { label: 'Mail', href: 'mailto:me@sryu.dev' },
  { label: 'GitHub', href: 'https://github.com/sangwon090' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/sangwon090' },
  { label: 'Résumé', href: localizedPath(locale, 'resume/') },
  { label: 'CV', href: localizedPath(locale, 'cv/') },
];
---

<footer class="site-footer">
  <div class="container-wide footer-inner">
    <p class="copy">{t(locale, 'footer.copyright', { year })}</p>
    <p class="links">
      {
        links.map((link, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">·</span>}
            <a href={link.href} rel={link.href.startsWith('http') ? 'noopener' : undefined}>
              {link.label}
            </a>
          </>
        ))
      }
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-12);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-subtle);
    font-size: var(--fs-sm);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .copy, .links {
    margin: 0;
  }

  .links {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .links a {
    color: var(--color-text-subtle);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .links a:hover {
    color: var(--color-accent);
  }

  .sep {
    color: var(--color-border-strong);
  }
</style>
