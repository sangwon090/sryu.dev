---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsByLocale, tagCounts } from '../utils/posts';
import { t, type Locale } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const posts = await getPostsByLocale(locale);
const tags = Array.from(tagCounts(posts).entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0]);
});
---

<BaseLayout locale={locale} title={t(locale, 'tags.title')}>
  <section class="container tags-page">
    <header class="page-head">
      <h1>{t(locale, 'tags.title')}</h1>
    </header>

    <ul class="tag-list" role="list">
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={localizedPath(locale, `tags/${encodeURIComponent(tag)}/`)}>
              <span class="tag-name">#{tag}</span>
              <span class="tag-count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .tags-page { max-width: var(--width-prose); }
  .page-head { margin-bottom: var(--space-6); }
  .page-head h1 { margin: 0; font-size: var(--fs-2xl); }

  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-3);
  }

  .tag-list a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .tag-list a:hover {
    border-color: var(--color-border-strong);
    color: var(--color-accent);
  }

  .tag-count {
    color: var(--color-text-subtle);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
</style>
