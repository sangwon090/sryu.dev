---
import type { TocItem } from '../utils/toc';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  items: TocItem[];
  locale: Locale;
  /** When true, renders the mobile collapsed variant. */
  variant?: 'sidebar' | 'mobile';
}

const { items, locale, variant = 'sidebar' } = Astro.props;
const heading = t(locale, 'article.toc');

function renderList(items: TocItem[]): string {
  if (items.length === 0) return '';
  const inner = items
    .map(
      (item) =>
        `<li><a href="#${item.slug}" data-toc-link>${item.text}</a>${renderList(item.children)}</li>`,
    )
    .join('');
  return `<ol>${inner}</ol>`;
}

const html = renderList(items);
---

{
  items.length > 0 &&
    (variant === 'mobile' ? (
      <details class="toc toc-mobile" data-toc-mobile>
        <summary>{heading}</summary>
        <nav aria-label={heading} set:html={html} />
      </details>
    ) : (
      <nav class="toc toc-sidebar" aria-label={heading}>
        <p class="toc-heading">{heading}</p>
        <Fragment set:html={html} />
      </nav>
    ))
}

<script>
  // Highlight the currently visible heading via IntersectionObserver.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0 && 'IntersectionObserver' in window) {
    const map = new Map<string, HTMLAnchorElement[]>();
    for (const link of links) {
      const id = decodeURIComponent(link.hash.slice(1));
      const list = map.get(id) ?? [];
      list.push(link);
      map.set(id, list);
    }

    const headings: HTMLElement[] = [];
    map.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) headings.push(el);
    });

    let active: string | null = null;

    function setActive(id: string | null) {
      if (active === id) return;
      if (active) {
        map.get(active)?.forEach((a) => a.removeAttribute('data-active'));
      }
      if (id) {
        map.get(id)?.forEach((a) => a.setAttribute('data-active', 'true'));
      }
      active = id;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );

    for (const h of headings) observer.observe(h);
  }
</script>

<style>
  .toc {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    line-height: var(--lh-snug);
  }

  .toc :global(ol) {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc :global(li) {
    margin-top: var(--space-2);
  }

  .toc :global(li ol) {
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
    margin-top: var(--space-2);
  }

  .toc :global(a) {
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--dur-fast) var(--ease);
    display: block;
    padding: 0.125rem 0;
  }

  .toc :global(a:hover) {
    color: var(--color-text);
  }

  .toc :global(a[data-active='true']) {
    color: var(--color-accent);
  }

  /* ----- Sidebar variant ----- */
  .toc-sidebar {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border);
  }

  .toc-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  /* ----- Mobile variant ----- */
  .toc-mobile {
    margin: var(--space-5) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
  }

  .toc-mobile > summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    list-style: none;
  }

  .toc-mobile > summary::-webkit-details-marker { display: none; }

  .toc-mobile > summary::after {
    content: '+';
    float: right;
    font-family: var(--font-mono);
  }

  .toc-mobile[open] > summary::after {
    content: '−';
  }

  .toc-mobile > nav {
    margin-top: var(--space-3);
  }
</style>
